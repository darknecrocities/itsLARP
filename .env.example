# itsLARP Environment Configuration Template
# Copy this file to .env and configure for your local environment

# --- Web & API Endpoints ---
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PORT=8000

# --- Database & Cache ---
POSTGRES_USER=larp
POSTGRES_PASSWORD=
POSTGRES_DB=itslarp
DATABASE_URL=postgresql://larp@localhost:5432/itslarp
REDIS_URL=redis://localhost:6379/0

# --- Local AI & Ollama Engine ---
OLLAMA_HOST=http://localhost:11434
AI_PROVIDER=ollama
AI_MODEL=qwen2.5-coder:7b

# --- Optional Cloud AI Providers (Fallback Only) ---
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Optional Notion Integration ---
# NOTION_API_KEY=your_notion_api_key_here
