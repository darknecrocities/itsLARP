# itsLARP Environment Configuration Template
# Copy this file to .env and configure your local credentials.

# Notion Integration
NOTION_API_KEY=your_notion_api_token_here
NOTION_TOKEN=your_notion_api_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Local Desktop Server
PORT=3000
API_PORT=8000

# Firebase Live Counters Configuration (Firestore)
# For web (landing page), see apps/web/.env.example and configure on Vercel.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
